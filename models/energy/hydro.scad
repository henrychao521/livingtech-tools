// 水力發電 Hydroelectric Dam — 重力壩 + 發電廠房
$fn = 32;

// 水壩主體（混凝土灰）
color([0.65, 0.64, 0.62])
  hull() {
    translate([-70, -20, 0]) cube([140, 40, 5]);
    translate([-60, -15, 80]) cube([120, 30, 5]);
  }

// 壩頂道路
color([0.55, 0.54, 0.52])
  translate([-58, -13, 84]) cube([116, 26, 6]);

// 壩頂護欄
color([0.72, 0.72, 0.75]) {
  translate([-58, -13, 90]) cube([116, 2, 5]);
  translate([-58, 11, 90]) cube([116, 2, 5]);
  for (x = [-56, -42, -28, -14, 0, 14, 28, 42, 56])
    translate([x, -13, 90]) cube([2, 24, 8]);
}

// 上游水面（藍色）
color([0.15, 0.45, 0.75, 0.7])
  translate([-70, -20, 70]) cube([140, 40, 15]);

// 發電廠房（壩底）
color([0.58, 0.58, 0.60])
  translate([-55, -18, 0]) cube([110, 36, 25]);

// 水輪機出口（圓形）
color([0.45, 0.45, 0.48])
  for (x = [-35, -10, 15, 40])
    translate([x, 18, 5]) rotate([90, 0, 0]) cylinder(h = 5, r = 7);

// 泄洪閘門
color([0.38, 0.38, 0.42]) {
  translate([-20, -22, 40]) cube([40, 5, 35]);
  translate([-18, -22, 38]) cube([36, 3, 2]);
  translate([-18, -22, 75]) cube([36, 3, 2]);
}

// 輸電線塔
color([0.42, 0.42, 0.45])
  translate([75, 0, 0]) {
    cylinder(h = 60, r = 2);
    translate([-15, 0, 50]) cube([30, 2, 2]);
    translate([-12, 0, 40]) cube([24, 2, 2]);
  }
