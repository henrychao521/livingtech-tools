// 水力發電 Hydroelectric Dam — 重力壩 + 水庫 + 壩底發電廠房
// 座標：+Y 為上游（水庫側），-Y 為下游（發電廠房、尾水側）；Z 向上
$fn = 32;

// 地面基座
color([0.55, 0.54, 0.52])
  translate([-85, -65, -4]) cube([170, 130, 4]);

// 水壩主體（重力壩：上游面垂直、下游面傾斜）
color([0.65, 0.64, 0.62])
  hull() {
    translate([-70, -20, 0]) cube([140, 40, 1]);   // 壩底：y -20 ～ 20
    translate([-60, 10, 80]) cube([120, 10, 1]);   // 壩頂：y 10 ～ 20（上游面 y = 20 垂直）
  }

// 壩頂道路
color([0.55, 0.54, 0.52])
  translate([-58, 10, 81]) cube([116, 10, 5]);

// 壩頂護欄
color([0.72, 0.72, 0.75]) {
  translate([-58, 10, 86]) cube([116, 1.5, 5]);
  translate([-58, 18.5, 86]) cube([116, 1.5, 5]);
  for (x = [-56, -42, -28, -14, 0, 14, 28, 42, 56])
    translate([x, 10, 86]) cube([2, 10, 7]);
}

// 水庫（上游水面，位在壩的 +Y 側，水位低於壩頂）
color([0.15, 0.45, 0.75, 0.7])
  translate([-85, 20, 0]) cube([170, 45, 72]);

// 溢洪道閘門（壩頂中央、上游側）
color([0.38, 0.38, 0.42]) {
  translate([-20, 20, 60]) cube([40, 3, 32]);   // 閘門板
  translate([-22, 8, 80]) cube([3, 15, 14]);    // 閘墩（左）
  translate([19, 8, 80]) cube([3, 15, 14]);     // 閘墩（右）
}

// 發電廠房（壩底下游側，緊貼壩趾）
color([0.58, 0.58, 0.60])
  translate([-55, -46, 0]) cube([110, 30, 25]);

// 壓力鋼管（沿下游壩面把水引到廠房的水輪機）
color([0.45, 0.45, 0.48])
  for (x = [-35, -10, 15, 40])
    translate([x, -15.8, 21.2]) rotate([-20.6, 0, 0]) cylinder(h = 45, r = 3.5);

// 水輪機尾水出口（廠房下游面，朝 -Y）
color([0.30, 0.30, 0.33])
  for (x = [-35, -10, 15, 40])
    translate([x, -46, 8]) rotate([90, 0, 0]) cylinder(h = 4, r = 6);

// 輸電線塔（廠房旁）
color([0.42, 0.42, 0.45])
  translate([75, -35, 0]) {
    cylinder(h = 60, r = 2);
    translate([-15, 0, 50]) cube([30, 2, 2]);
    translate([-12, 0, 40]) cube([24, 2, 2]);
  }
