// 太陽能板 Solar Panel — 多晶矽電池陣列
$fn = 32;

// 鋁框架（外框）
color([0.70, 0.72, 0.75]) {
  translate([-60, -40, 0]) cube([120, 5, 5]);  // 下框
  translate([-60, 35, 0]) cube([120, 5, 5]);   // 上框
  translate([-60, -40, 0]) cube([5, 80, 5]);   // 左框
  translate([55, -40, 0]) cube([5, 80, 5]);    // 右框
}

// 玻璃背板
color([0.15, 0.22, 0.38])
  translate([-55, -35, 0]) cube([110, 75, 2]);

// 太陽能電池格（4×6 = 24格，藍黑色多晶矽）
for (col = [0:3]) for (row = [0:5]) {
  color([0.08, 0.12, 0.40])
    translate([-50 + col*26, -30 + row*12, 2]) cube([24, 11, 1]);
  // 電池內格線
  color([0.55, 0.65, 0.80])
    for (l = [0:3])
      translate([-50 + col*26 + l*6, -30 + row*12, 3]) cube([0.5, 11, 0.3]);
}

// 匯流條（銀色橫條）
color([0.82, 0.84, 0.86])
  for (row = [0:5])
    translate([-54, -30 + row*12 + 5, 3]) cube([108, 1, 0.5]);

// 接線盒（背面出線）
color([0.18, 0.18, 0.20])
  translate([10, 0, -8]) cube([16, 12, 8]);

// 支撐架（斜角）
color([0.60, 0.62, 0.65]) {
  translate([-50, -40, -25]) rotate([0, -25, 0]) cube([8, 80, 28]);
  translate([42, -40, -25]) rotate([0, 25, 0]) cube([8, 80, 28]);
}
color([0.50, 0.52, 0.55])
  translate([-50, 0, -26]) cube([100, 5, 4]);
