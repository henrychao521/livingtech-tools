// 楔形 Wedge — 兩個斜面背靠背組成的劈刀／斧頭刀刃
include <_common.scad>

// 楔形主體（三角形截面立在 XZ 平面：上方寬 40、下方收成刃口；沿 Y 深 40）
// 刃口在 z = 0，剛好插進下方木塊頂面（z = 4）的裂縫裡
// 舊版把三角形畫在 XY 水平面，楔形躺平且 z∈[-20,20] 穿到木塊底下
color([0.86, 0.15, 0.46])
  rotate([90, 0, 0]) linear_extrude(height = 40, center = true)
    polygon([[-20, 30], [20, 30], [0, 0]]);

// 被劈開的木塊（在楔形下方，象徵被劈開）
color([0.62, 0.27, 0.12]) {
  // 左半
  translate([-32, -22, -14]) cube([14, 44, 18]);
  // 右半（往外推）
  translate([18, -22, -14]) cube([14, 44, 18]);
}
