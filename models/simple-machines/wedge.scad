// 楔形 Wedge — 兩個斜面背靠背組成的劈刀／斧頭刀刃
include <_common.scad>

// 楔形主體（兩個三角形拼成的「劈」形狀）
// 從側面看：上方寬、下方收成一點
color([0.86, 0.15, 0.46])
  translate([0, 0, -20]) linear_extrude(height = 40)
    polygon([[-20, 30], [20, 30], [0, 0]]);

// 被劈開的木塊（在楔形下方，象徵被劈開）
color([0.62, 0.27, 0.12]) {
  // 左半
  translate([-32, -22, -14]) cube([14, 44, 18]);
  // 右半（往外推）
  translate([18, -22, -14]) cube([14, 44, 18]);
}
