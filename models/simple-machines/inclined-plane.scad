// 斜面 Inclined Plane — 直角三角形拉伸 + 物體在斜面上
include <_common.scad>

// 斜面本體（直角三角形，立在 XZ 平面：底長 80、高 35，右高左低；深度 40）
// 舊版把三角形畫在 XY 水平面，斜面變成直立的牆，方塊也沒貼在斜面上
color([0.86, 0.15, 0.46])
  rotate([90, 0, 0]) linear_extrude(height = 40, center = true)
    polygon([[-40, 0], [40, 0], [40, 35]]);

// 物體（方塊貼在斜面上，位於斜面下半段）
// 斜面高度 z = 35·(x+40)/80；x = −25 時 z ≈ 6.6；繞 Y 轉 −atan(35/80) 讓方塊底面貼齊斜面
color([0.32, 0.08, 0.16])
  translate([-25, -10, 35 * 15 / 80])
    rotate([0, -atan(35/80), 0])
      cube([16, 20, 16]);
