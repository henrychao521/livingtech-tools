// 線鋸機 Scroll Saw — 機台 + 上下臂 + 鋸片
// 座標約定：立柱在 -X 後方，懸臂往 +X 伸出，操作者站在 +X 側面對機台；-Y 為操作者左手邊（控制面板）。
// 高度關鍵尺寸：工作台面 z=106、下夾頭 z=86~98（台面下）、上夾頭 z=120~132、鋸片 z=86~132 穿過台面。
$fn = 40;

// 底座（鑄鐵，深灰）
color([0.28, 0.28, 0.30])
  translate([-70, -45, 0]) cube([140, 90, 20]);
// 底座加強肋
color([0.22, 0.22, 0.24])
  for (x = [-40, 0, 40])
    translate([x-3, -43, 4]) cube([6, 86, 16]);
// 腳墊（四角）
color([0.12, 0.12, 0.14])
  for (px = [-60, 60]) for (py = [-35, 35])
    translate([px-8, py-8, -6]) cube([16, 16, 8]);

// 機台主柱（左後方立柱）
color([0.32, 0.32, 0.35])
  translate([-55, -10, 20]) cube([20, 20, 160]);

// 下臂（水平，連接立柱到鋸片下方）
color([0.38, 0.38, 0.40])
  translate([-35, -8, 40]) cube([100, 16, 18]);

// 下臂前端（支撐下夾頭；頂到 z=86，不能高過下夾頭）
color([0.35, 0.35, 0.37])
  translate([55, -10, 40]) cube([16, 20, 46]);

// 下端夾頭（在工作台「下方」，台面底 z=98）
color([0.55, 0.56, 0.58])
  translate([58, -4, 86]) cube([10, 8, 12]);

// 上臂（弧形連接，連接立柱到鋸片上方；前端垂柱停在 z=130，下面接上夾頭）
color([0.38, 0.38, 0.40]) {
  translate([-55, -8, 170]) cube([20, 16, 18]);
  translate([-35, -8, 165]) cube([100, 16, 22]);
  translate([55, -10, 130]) cube([16, 20, 58]);
}

// 上端夾頭（掛在上臂前端下方，台面上方約 14mm 淨空給木料）
color([0.55, 0.56, 0.58])
  translate([58, -4, 120]) cube([10, 8, 12]);

// 鋸片（細長，金屬色；由下夾頭穿過工作台到上夾頭）
color([0.70, 0.72, 0.75])
  translate([61, -1, 86]) cube([2, 2, 46]);
// 鋸齒（示意；在 +X 前緣，面向操作者）
color([0.55, 0.56, 0.58])
  for (z = [88:3:130])
    translate([63, -0.5, z]) cube([1.5, 1, 1.5]);

// 工作台（水平平台，台面 z=106）
color([0.42, 0.43, 0.45])
  translate([-15, -45, 98]) cube([90, 90, 8]);
// 工作台插槽（鋸片通過孔）
color([0.20, 0.20, 0.22])
  translate([60, -2, 97]) cube([4, 4, 10]);

// 壓料腳（hold-down）：從上臂前端垂下的桿子 + 停在台面上方的腳座，緊鄰鋸片側邊
color([0.50, 0.50, 0.52]) {
  translate([52, -14, 128]) cube([6, 8, 4]);      // 固定座（接上臂前端）
  translate([52, -14, 108]) cube([3, 3, 22]);     // 垂直桿
  translate([48, -17, 107]) cube([12, 11, 1.5]);  // 腳座（台面上方約一片薄板厚）
}

// 工作台燈（LED 條）
color([0.88, 0.88, 0.20, 0.8])
  translate([40, 46, 106]) cube([18, 4, 4]);

// 控制盒（固定在底座前緣、靠立柱）
color([0.24, 0.24, 0.26])
  translate([-56, -46, 20]) cube([30, 36, 45]);
// 速度調節旋鈕（控制盒前面板）
color([0.82, 0.82, 0.85])
  translate([-33, -46, 55]) rotate([90, 0, 0]) cylinder(h = 8, r = 6);
// 電源開關（大紅色，控制盒前面板）
color([0.85, 0.08, 0.08])
  translate([-46, -46, 32]) rotate([90, 0, 0]) cylinder(h = 6, r = 7);

// 下吹管（吹走木屑）：從上臂前端斜下對準鋸片切割點
color([0.55, 0.56, 0.58])
  translate([44, -6, 134]) rotate([0, 150, 0]) cylinder(h = 30, r = 3);

// 集塵袋接口（底座後方，朝 +Y 伸出）
color([0.30, 0.30, 0.33])
  translate([-50, 45, 10]) rotate([-90, 0, 0]) cylinder(h = 12, r = 8);
