// T 槽塊：頂面有「T 字形」凹槽（從 +Y 看像 T）
// 主體 80×60×30，從頂部挖 T 形溝槽
include <_common.scad>

difference() {
  // 主體
  translate([-40, -15, -30]) cube([80, 30, 60]);
  // T 字形溝槽：中央寬通道 + 頂部窄入口
  // T 的橫條（深 10）
  translate([-30, 5, 0]) cube([60, 12, 30]);
  // T 的直條（從橫條中央往下到底）
  translate([-10, -10, 0]) cube([20, 18, 30]);
}
