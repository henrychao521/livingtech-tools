// 階梯塊：下層 80×40×30 + 上層 40×40×30（疊在下層左半），與三視圖首頁主圖同一件
// 正視(XZ) = 左高右低的階梯 L 形；俯視(XY) = 矩形，x=0 有高低分界線；
// 右側視(YZ) = 矩形，z=30 有上下兩個右面的分界線
include <_common.scad>

union() {
  // 下層：x∈[-40,40]  y∈[-20,20]  z∈[0,30]
  translate([-40, -20, 0]) cube([80, 40, 30]);
  // 上層：x∈[-40,0]   y∈[-20,20]  z∈[30,60]
  translate([-40, -20, 30]) cube([40, 40, 30]);
}
