// FDM 3D 印表機 (Ender-3 style)
$fn = 32;

// 底座框架（黑色 V-slot 鋁型材）
color([0.15, 0.15, 0.17]) {
  // 底部水平框
  translate([-80, -80, 0]) cube([160, 8, 8]);   // 前框
  translate([-80, 72, 0]) cube([160, 8, 8]);    // 後框
  translate([-80, -80, 0]) cube([8, 160, 8]);   // 左框
  translate([72, -80, 0]) cube([8, 160, 8]);    // 右框
}

// 垂直立柱（兩根）
color([0.18, 0.18, 0.20]) {
  translate([-80, -80, 0]) cube([8, 8, 250]);
  translate([72, -80, 0]) cube([8, 8, 250]);
}

// 頂部橫樑
color([0.15, 0.15, 0.17])
  translate([-80, -80, 244]) cube([160, 8, 8]);

// 熱床（加熱平台，黑色彈簧鋼板）
color([0.20, 0.20, 0.22])
  translate([-65, -65, 30]) cube([130, 130, 4]);
// 熱床 PEI 面
color([0.30, 0.28, 0.25])
  translate([-63, -63, 34]) cube([126, 126, 1.5]);
// 熱床 4 角彈簧
color([0.55, 0.55, 0.58])
  for (x = [-55, 55]) for (y = [-55, 55])
    translate([x, y, 10]) cylinder(h = 22, r = 4);

// X 軸橫樑（沿 Z 軸升降；高度對齊目前列印到的層，噴嘴尖端剛好在物件頂面 z=60）
color([0.18, 0.18, 0.20])
  translate([-80, -10, 70]) cube([160, 8, 8]);

// 列印頭 + 噴嘴（Bowden style）
color([0.28, 0.28, 0.30])
  translate([-10, -8, 78]) cube([20, 16, 30]);
// 加熱塊
color([0.75, 0.52, 0.10])
  translate([-6, -5, 70]) cube([12, 10, 12]);
// 噴嘴（黃銅，尖端 z=60 = 列印中物件頂面）
color([0.65, 0.50, 0.08])
  translate([0, 0, 60]) cylinder(h = 10, r1 = 1, r2 = 3);
// 散熱風扇
color([0.22, 0.22, 0.25])
  translate([-14, -14, 88]) cube([12, 12, 12]);
// 吹風扇
color([0.22, 0.22, 0.25])
  translate([4, -14, 78]) cube([12, 8, 10]);

// Z 軸：步進馬達（左立柱內側底部）+ 梯形螺桿（T8）
color([0.12, 0.12, 0.14])
  translate([-72, -82, 8]) cube([22, 22, 30]);
color([0.70, 0.70, 0.72])
  translate([-61, -71, 38]) cylinder(h = 210, r = 2);

// Bowden 擠出機（裝在左立柱上，經鐵氟龍管把線材推到列印頭）
color([0.12, 0.12, 0.14])
  translate([-72, -58, 190]) cube([22, 22, 22]);   // 擠出機步進馬達（立柱前側，避開 Z 螺桿）
color([0.55, 0.55, 0.58])
  translate([-50, -47, 201]) rotate([0, 90, 0]) cylinder(h = 10, r = 6);   // 送料齒輪
// 鐵氟龍管（擠出機 → 列印頭，用多段短圓柱近似一條弧線）
color([0.90, 0.90, 0.92])
  for (i = [0 : 11]) {
    t = i / 12;
    a = [-45 + 45 * t, -47 + 39 * t, 212 + 44 * sin(180 * t) - 104 * t];
    b = [-45 + 45 * (t + 1/12), -47 + 39 * (t + 1/12), 212 + 44 * sin(180 * (t + 1/12)) - 104 * (t + 1/12)];
    hull() { translate(a) sphere(r = 1.5); translate(b) sphere(r = 1.5); }
  }

// 料架（頂樑上立一支架在線圈側邊 + 橫向軸桿穿過線圈中心）
color([0.15, 0.15, 0.17])
  translate([16, -80, 252]) cube([8, 8, 44]);
color([0.55, 0.55, 0.58])
  translate([-25, -76, 296]) rotate([0, 90, 0]) cylinder(h = 50, r = 4);
// 耗材線圈（掛在料架上，軸向沿 X、直立；線材由此往下送進擠出機）
color([0.85, 0.30, 0.30])
  translate([-15, -76, 296]) rotate([0, 90, 0]) {
    difference() {   // 線材
      cylinder(h = 30, r = 40);
      translate([0, 0, -1]) cylinder(h = 32, r = 20);
    }
    difference() {   // 捲盤邊緣
      cylinder(h = 30, r = 42);
      translate([0, 0, -1]) cylinder(h = 32, r = 40);
    }
  }

// 列印中的物件（小方塊，白色）
color([0.96, 0.96, 0.96])
  translate([-8, -8, 35]) cube([16, 16, 25]);
color([0.90, 0.90, 0.92])
  for (z = [35, 40, 45, 50, 55])
    translate([-8, -8, z]) cube([16, 16, 1]);

// 電源供應器（熱床下方；原本位置會和 Z 軸馬達、熱床邊緣互相穿插）
color([0.12, 0.12, 0.14])
  translate([-30, -78, 8]) cube([44, 25, 20]);

// 控制主板（右下）
color([0.06, 0.22, 0.06])
  translate([38, -78, 8]) cube([34, 30, 4]);
