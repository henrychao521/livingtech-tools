// 框架 Frame — 樑+柱組成的高樓結構（4 根柱 × 4 層樑，3 層樓板）
include <_common.scad>

color([0.36, 0.42, 0.55]) {
  // 4 根角柱（從底到頂層樑頂）
  for (x = [-22, 22]) for (y = [-12, 12]) {
    translate([x - 2.5, y - 2.5, -30]) cube([5, 5, 66]);
  }
  // 4 層樑（每層 X 向 2 條 + Y 向 2 條，與柱剛接成框架）
  for (z = [-28, -8, 12, 32]) {
    // 樑中心線對齊柱中心線（y = ±12、x = ±22）；2026-10 本機算繪後修正：原本以角點為起點，樑整體往內偏 2.5
    // 沿 X 方向的兩條樑
    translate([-22, -14.5, z]) cube([44, 5, 4]);
    translate([-22, 9.5, z]) cube([44, 5, 4]);
    // 沿 Y 方向的兩條樑
    translate([-24.5, -12, z]) cube([5, 24, 4]);
    translate([19.5, -12, z]) cube([5, 24, 4]);
  }
}

// 樓板（半透明示意）
color([0.86, 0.6, 0.3, 0.6]) {
  translate([-22, -12, -28]) cube([44, 24, 1]);
  translate([-22, -12, -8]) cube([44, 24, 1]);
  translate([-22, -12, 12]) cube([44, 24, 1]);
}
