// 桁架 Truss — Pratt 型（4 格：豎桿受壓、斜桿由上弦往跨中向下傾受張）
include <_common.scad>

// 斜桿：從 (x0, z0) 連到 (x1, z1) 的方桿（繞 Y 軸旋轉，z 軸轉到 (dx, dz) 方向）
module diag(x0, z0, x1, z1) {
  translate([x0, 0, z0])
    rotate([0, atan2(x1 - x0, z1 - z0), 0])
      translate([-1.5, -2.5, 0]) cube([3, 5, norm([x1 - x0, z1 - z0])]);
}

color([0.36, 0.42, 0.55]) {
  // 下弦（底）4 段：x = -40 ～ 40
  for (i = [-2:1]) translate([i * 20 - 1.5, -2.5, -15]) cube([23, 5, 3]);
  // 上弦（頂）4 段：與下弦等長、對齊豎桿
  for (i = [-2:1]) translate([i * 20 - 1.5, -2.5, 12]) cube([23, 5, 3]);
  // 豎桿 5 根（兩端為端柱）— Pratt 特徵：受壓
  for (x = [-40, -20, 0, 20, 40]) translate([x - 1.5, -2.5, -15]) cube([3, 5, 30]);
  // 斜桿 — Pratt 特徵：由上弦往跨中向下傾（左半 ↘、右半 ↙），在下弦中央會合成 V，受張
  diag(-20, -15, -40, 15);
  diag(  0, -15, -20, 15);
  diag(  0, -15,  20, 15);
  diag( 20, -15,  40, 15);
}

// 中央懸吊重物
color([0.86, 0.25, 0.25])
  translate([-7, -7, -28]) cube([14, 14, 10]);
