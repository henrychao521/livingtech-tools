// 刀類 Knife — 美工刀（黃色塑膠柄 + 銀色刀片）
include <_common.scad>

// 黃色塑膠刀身
color([0.95, 0.75, 0.10])
  translate([-3, -7, 0]) cube([100, 14, 8]);

// 滑動鈕（橘色）：在刀身背脊（-Y 面，刀片的背側；預設等角視角看得到這一面），2026-10 修正：原本誤放在寬面上
color([0.95, 0.45, 0.10])
  translate([20, -9, 1.5]) cube([10, 3, 5]);

// 刀片（折刀式梯形刀片，從刀身前端伸出；刃口是 +Y 側的長直邊、刀尖在刃側，斜邊是折斷線方向）
color([0.85, 0.85, 0.85])
  translate([95, 0, 3.5])
    linear_extrude(height = 1)
      polygon([[0, 6], [0, -6], [12, -6], [24, 6]]);
// 折斷線（與刀片斜邊平行的刻痕）
color([0.45, 0.45, 0.45])
  for (k = [1:2]) translate([95 - k * 7, 0, 4.55])
    linear_extrude(height = 0.2) polygon([[12, -6], [12.6, -6], [24.6, 6], [24, 6]]);
