// 量測 Measuring — 捲尺（黃色塑膠殼 + 鋼尺帶）
include <_common.scad>

// 主殼體（黃色 box）
color([0.95, 0.75, 0.10])
  translate([-25, -15, 0]) cube([50, 30, 35], $fn = 32);

// 2026-10 修正：尺帶原本從殼體半高伸出、鉤頭上下對稱；實物是從殼底前方伸出、平貼桌面，
// 末端鉤頭向下彎成 L 形（勾住工件邊緣），尺帶伸出長一點才看得出是捲尺
// 鋼尺帶（黃色、從殼底伸出）
color([0.98, 0.85, 0.20])
  translate([-60, -9, 0.5]) cube([36, 18, 1]);
// 尺帶刻度線（小黑線示意）
color([0.18, 0.18, 0.18])
  for (i = [0:16]) translate([-58 + i * 2, -9, 1.5]) cube([0.4, (i % 5 == 0) ? 8 : 4, 0.3]);
// 鉤頭（尺帶末端向下彎的金屬鉤，L 形）
color([0.6, 0.6, 0.6]) {
  translate([-61, -9.5, -6]) cube([1.2, 19, 7.5]);
  translate([-61, -9.5, 0.5]) cube([3, 19, 1.2]);
}
