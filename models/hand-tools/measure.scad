// 量測 Measuring — 捲尺（黃色塑膠殼 + 鋼尺帶）
include <_common.scad>

// 主殼體（黃色 box）
color([0.95, 0.75, 0.10])
  translate([-25, -15, 0]) cube([50, 30, 35], $fn = 32);

// 上方握把凹陷（簡化用一個小圓角矩形 cut）
color([0.95, 0.75, 0.10])
  translate([-22, -12, 25]) cube([44, 24, 4]);

// 鋼尺帶（從殼體側面伸出）
color([0.85, 0.85, 0.85])
  translate([-30, -10, 12]) cube([8, 20, 1.5]);
// 尺帶刻度線（小黑線示意）
color([0.18, 0.18, 0.18])
  for (i = [0:7]) translate([-29 + i, -10, 13.6]) cube([0.3, 4, 0.3]);

// 鉤頭（尺帶末端的金屬鉤）
color([0.6, 0.6, 0.6])
  translate([-32, -10, 11]) cube([3, 20, 4]);
