// 手鋸 Saw — 木柄 + 鋸條（帶齒）
include <_common.scad>

// 鋸條（薄長方體）
color([0.7, 0.7, 0.72])
  translate([0, -0.4, 0]) cube([130, 0.8, 18]);

// 鋸齒（沿底邊一排，與鋸條同平面、尖端朝下）
// 2026-10 修正：原本對稱三角形看不出切削方向。D 形握把的西式夾背鋸是推切：
// 齒的切削面（陡邊）朝鋸尖（-X，遠離握把），緩坡朝握把，推的時候齒尖吃進木材。
color([0.55, 0.55, 0.55])
  for (i = [0:15])
    translate([i * 8 + 4, 0.4, 0])
      rotate([90, 0, 0])
        linear_extrude(height = 0.8) polygon([[-4, 0], [-3.4, -6], [4, 0]]);   // 齒放大成示意尺寸，等角圖上才看得出方向

// 鋸條與握把連接 backbone（鋼條加固）
color([0.30, 0.30, 0.30])
  translate([0, -1, 16]) cube([130, 2, 3]);

// D 形木柄（2026-10 修正：原本是圓環，改成手握的 D 形把手）
color([0.55, 0.27, 0.13])
  translate([0, 4, 0]) rotate([90, 0, 0])
    linear_extrude(height = 8)
      difference() {
        polygon([[126, -6], [126, 26], [146, 34], [166, 26], [172, 6], [164, -12], [140, -16]]);
        polygon([[140, -4], [140, 20], [152, 24], [160, 16], [160, 0], [152, -6]]);
      }
