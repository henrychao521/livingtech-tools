// 銼刀 File — 木柄 + 銼齒鋼身（平銼）
include <_common.scad>

// 木柄（圓錐握把）
color([0.62, 0.27, 0.12])
  cylinder(h = 50, r1 = 11, r2 = 9, $fn = 32);

// 金屬箍（柄口）：2026-10 修正：原本把莖部畫在柄外；實物莖部插在木柄裡，柄口有金屬箍
color([0.55, 0.55, 0.55])
  translate([0, 0, 47]) cylinder(h = 6, r = 9.5);

// 銼身（平銼：往前端逐漸變窄、變薄，帶銼齒紋）
color([0.65, 0.65, 0.7])
  hull() {
    translate([-6, -4, 53]) cube([12, 8, 0.1]);
    translate([-4, -2.5, 150]) cube([8, 5, 0.1]);
  }
// 銼齒（淺溝紋一排）
color([0.45, 0.45, 0.50])
  for (i = [0:20]) translate([-6 + i * 0.09, -4.05 + i * 0.07, 60 + i*4]) cube([12 - i * 0.18, 0.5, 1.2]);

